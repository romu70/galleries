---
import Item from '../components/Item.astro';
import Symbols from "../components/Symbols.astro";

const { collection, compare } = Astro.props;
---

<Symbols />

<div id="filter-indicator" class="filter-indicator">
  <span id="filter-label"></span>
  <button id="filter-clear" aria-label="Clear filter">✕</button>
</div>

<div class="items-grid" id="items-grid">
  {
    collection.sort(compare).map((item: any, index: number) => (
      // <Debug {item}/>
      <Item item={item} index={index}/>
    ))
  }
</div>

<script>
  type Divs = NodeListOf<HTMLElement> | null | undefined;
  type Div = HTMLElement | null | undefined;
  let grid: Element | null = null;
  let thumbnails: Divs = null;
  let details: Divs = null;
  let currentShownDetail: Div = null;
  let detailPaneHeight: number = 0;
  let currentThumbnailHeight: number = 0;
  let rem: number = 0;
  let mobileViewBreakpoint: number = 0;
  let currentFilter: string | null = null;
  let visibleThumbnails: HTMLElement[] = [];

  // Init
  document.addEventListener('DOMContentLoaded', function () {
    grid = document.querySelector("#items-grid");
    thumbnails = grid?.querySelectorAll('.thumbnail');
    details = grid?.querySelectorAll('.detail');
    visibleThumbnails = Array.from(thumbnails || []);
    hideAllDetails();
    addThumbnailImageClick();
    addKeyboardManagement();
    addTagClick();
    addDetailClick('.close-button', onDetailCloseClick);
    addDetailClick('.next-button', onDetailNextClick);
    addDetailClick('.previous-button', onDetailPreviousClick);
    document.getElementById('filter-clear')?.addEventListener('click', clearFilter);
    window.addEventListener('resize', onWindowResize);
  });

  // Read the CSS variables when needed, not at DOMContentLoaded: Safari can fire
  // it before the stylesheets are applied, and the values would then be NaN.
  function readCssVariables() {
    const rootStyle = getComputedStyle(document.documentElement);
    detailPaneHeight = parseInt(rootStyle.getPropertyValue('--detail-pane-height'));
    rem = parseInt(rootStyle.fontSize);
    mobileViewBreakpoint = parseInt(rootStyle.getPropertyValue('--mobile-view-breakpoint'));
  }

  function addThumbnailImageClick() {
    thumbnails?.forEach(thumbnail => {
      thumbnail.children[0].addEventListener('click', onThumbnailImageClick);
    });
  }

  function addTagClick() {
    document.addEventListener('click', (e) => {
      const tag = (e.target as HTMLElement).closest('.tag') as HTMLElement | null;
      if (!tag) return;
      const tagName = tag.dataset.tag;
      if (!tagName) return;
      if (currentFilter === tagName) {
        clearFilter();
      } else {
        filterByTag(tagName);
      }
    });
  }

  function filterByTag(tag: string) {
    hideDetail(currentShownDetail);
    currentFilter = tag;

    grid?.querySelectorAll<HTMLElement>('.item').forEach(item => {
      const chips = Array.from(item.querySelectorAll<HTMLElement>('.tag'));
      const matches = chips.some(chip => chip.dataset.tag === tag);
      item.style.display = matches ? '' : 'none';
    });

    visibleThumbnails = Array.from(thumbnails || []).filter(
      t => (t.closest('.item') as HTMLElement | null)?.style.display !== 'none'
    );

    const label = document.getElementById('filter-label');
    if (label) label.textContent = tag;
    document.getElementById('filter-indicator')?.classList.add('visible');

    grid?.querySelectorAll<HTMLElement>('.tag').forEach(t => {
      t.classList.toggle('active', t.dataset.tag === tag);
    });
  }

  function clearFilter() {
    currentFilter = null;

    grid?.querySelectorAll<HTMLElement>('.item').forEach(item => {
      item.style.display = '';
    });

    visibleThumbnails = Array.from(thumbnails || []);

    document.getElementById('filter-indicator')?.classList.remove('visible');

    grid?.querySelectorAll<HTMLElement>('.tag').forEach(t => {
      t.classList.remove('active');
    });
  }

  function addKeyboardManagement() {
    document.addEventListener("keyup", (event) => {
      if (event.defaultPrevented) return;

      switch (event.key) {
        case "ArrowLeft": {
          if (!currentShownDetail) return;
          const idx = Number(currentShownDetail.dataset.index);
          const visibleIdx = visibleThumbnails.findIndex(t => Number(t.dataset.index) === idx);
          if (visibleIdx > 0) processImage(Number(visibleThumbnails[visibleIdx - 1].dataset.index));
          break;
        }
        case "ArrowRight": {
          if (!currentShownDetail) return;
          const idx = Number(currentShownDetail.dataset.index);
          const visibleIdx = visibleThumbnails.findIndex(t => Number(t.dataset.index) === idx);
          if (visibleIdx < visibleThumbnails.length - 1) processImage(Number(visibleThumbnails[visibleIdx + 1].dataset.index));
          break;
        }
        case "Escape":
          hideDetail(currentShownDetail);
          break;
        default:
          return;
      }

      event.preventDefault();
    });
  }

  function addDetailClick(clazz: string, callback: EventListenerOrEventListenerObject) {
    let buttons = grid?.querySelectorAll(clazz);
    buttons?.forEach(button => {
      button.addEventListener('click', callback);
    });
  }

  function hideAllDetails() {
    details?.forEach(detail => {
      detail.style.visibility = "collapse";
    });
  }

  function hideDetail(detail: Div) {
    if(detail != null) {
      detail.style.visibility = "collapse";
      currentShownDetail = null;
      document.body.classList.remove("detail-open");
      let thumbnail: Div = grid?.querySelector(`.thumbnail[data-index="${detail.dataset.index}"]`);
      markThumbnailInactive(thumbnail);
    }
  }

  function showDetail(detail: Div) {
    if(detail != null) {
      readCssVariables();

      let thumbnail: Div = grid?.querySelector(`.thumbnail[data-index="${detail.dataset.index}"]`);
      markThumbnailActive(thumbnail);

      layoutDetail(detail, thumbnail, true);

      detail.style.visibility = "visible";
      currentShownDetail = detail;

      // Lets the header stay on top of the full-screen pane on phones
      document.body.classList.add("detail-open");
    }
  }

  // Respect the media query. If width < 768, the detail is full screen,
  // if not, it's below the thumbnail's row and fills the rest of the window
  function layoutDetail(detail: HTMLElement, thumbnail: Div, scroll: boolean) {
    if(window.innerWidth < mobileViewBreakpoint) {
      // Mobile view: the CSS makes the pane full screen (fixed, inset 0).
      // Drop any inline position left by a previous wide-view opening.
      detail.style.top = "";
      detail.style.height = "";
      if(thumbnail?.parentElement) {
        thumbnail.parentElement.style.height = currentThumbnailHeight + "px";
      }
    } else if(thumbnail) {
      // Wide view: the thumbnail's row goes to the top of the window and the
      // pane takes the remaining height, never less than --detail-pane-height
      const rowTop = thumbnail.getBoundingClientRect().top + window.scrollY;
      const paneHeight = Math.max(window.innerHeight - currentThumbnailHeight, detailPaneHeight * rem);

      // Place the detail pane just below the thumbnail's line
      detail.style.top = (rowTop + currentThumbnailHeight) + "px";
      detail.style.height = paneHeight + "px";
      // Set the selected item height to "insert" the detail pane into the grid layout
      if(thumbnail.parentElement) {
        thumbnail.parentElement.style.height = (currentThumbnailHeight + paneHeight) + "px";
      }

      if(scroll) {
        // The idea of the timeout is taken from this:
        // https://stackoverflow.com/questions/71181018/scrollintoview-doesnt-scroll-anywhere
        setTimeout(function () {
          window.scrollTo({ top: rowTop, behavior: "smooth" });
        }, 100);
      }
    }
  }

  function onWindowResize() {
    if(!currentShownDetail) return;
    readCssVariables();
    let thumbnail: Div = grid?.querySelector(`.thumbnail[data-index="${currentShownDetail.dataset.index}"]`);
    layoutDetail(currentShownDetail, thumbnail, false);
  }

  function onThumbnailImageClick(this: HTMLElement, e: Event) {
    let parent: Div = this.parentNode as Div;
    let idx: number = Number(parent?.dataset.index);
    processImage(idx);
  }

  function processImage(index: number) {
    let detail: Div = grid?.querySelector(`.detail[data-index="${index}"]`);

    if(currentShownDetail == detail) {
      hideDetail(currentShownDetail);
    } else {
      hideDetail(currentShownDetail);
      showDetail(detail);

      const visibleIdx = visibleThumbnails.findIndex(t => Number(t.dataset.index) === index);
      const prevButton = grid?.querySelector<HTMLButtonElement>(`.detail[data-index="${index}"] .previous-button`);
      const nextButton = grid?.querySelector<HTMLButtonElement>(`.detail[data-index="${index}"] .next-button`);
      if (prevButton) prevButton.disabled = visibleIdx <= 0;
      if (nextButton) nextButton.disabled = visibleIdx >= visibleThumbnails.length - 1;
    }
  }

  function markThumbnailActive(thumbnail: Div) {
    // Save the thumbnail height
    if(thumbnail) {
      thumbnail.classList.add("active");
      currentThumbnailHeight = thumbnail.offsetHeight;
    }
  }

  function markThumbnailInactive(thumbnail: Div) {
    // Restore the thumbnail height
    if(thumbnail) {
      thumbnail.classList.remove("active");
      thumbnail.style.height = currentThumbnailHeight.toString() + "px";
      // Also restore the height of the Item div to remove empty space
      if(thumbnail.parentElement) {
        thumbnail.parentElement.style.height = currentThumbnailHeight.toString() + "px";
      }
    }
  }

  function onDetailCloseClick(this: HTMLElement, e: Event) {
    hideDetail(this.closest('.detail') as Div);
  }

  function onDetailNextClick(this: HTMLElement, e: Event) {
    const idx = Number(this.dataset.index);
    const visibleIdx = visibleThumbnails.findIndex(t => Number(t.dataset.index) === idx);
    if (visibleIdx < visibleThumbnails.length - 1) {
      processImage(Number(visibleThumbnails[visibleIdx + 1].dataset.index));
    }
  }

  function onDetailPreviousClick(this: HTMLElement, e: Event) {
    const idx = Number(this.dataset.index);
    const visibleIdx = visibleThumbnails.findIndex(t => Number(t.dataset.index) === idx);
    if (visibleIdx > 0) {
      processImage(Number(visibleThumbnails[visibleIdx - 1].dataset.index));
    }
  }
</script>

<style>
  .filter-indicator {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    color: white;
  }

  .filter-indicator.visible {
    display: flex;
  }

  #filter-clear {
    background: transparent;
    border: 1px solid var(--main-color);
    color: var(--main-color);
    border-radius: 100%;
    width: 1.4rem;
    height: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.7rem;
    padding: 0;
  }

  #filter-clear:hover {
    background-color: var(--main-color);
    color: var(--active-background-color);
  }

  .items-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    padding: 1em;
    width: 100vw;
    row-gap: 1rem;
  }

  @media (min-width: 360px) {
    .items-grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  @media (min-width: 440px) {
    .items-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .items-grid {
      grid-template-columns: repeat(3, 1fr);
      margin-bottom: 8rem;
	  }
  }

  /* Trick for portrait iPad */
  @media only screen and (min-width: 1024px) and (orientation: portrait) {
    .items-grid {
      grid-template-columns: repeat(3, 1fr);
      margin-bottom: 8rem;
	  }
  }

  @media only screen and (min-width: 1024px) and (orientation: landscape) {
    .items-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1282px) {
    .items-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (min-width: 1441px) {
    .items-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

</style>
