---
import { Image } from 'astro:assets';
import Date from '../components/Date.astro';
import Location from '../components/Location.astro';
import Tag from '../components/Tag.astro';

const { item, index } = Astro.props;

// Responsive thumbnail: the browser picks the smallest file that is sharp for
// the displayed size and the screen density. The visible part of a thumbnail
// gets at most 800 px: slightly soft on a 3x phone, about half the bytes of
// 1200 px.
const THUMB_WIDTHS = [400, 800];
const MAX_VISIBLE = 800;

// Width of the image box, per grid layout in Gallery.astro (.items-grid:
// 1rem padding each side; .thumbnail: 1rem padding each side).
const columns: [string, number][] = [
  ['(min-width: 1441px)', 6],
  ['(min-width: 1282px)', 5],
  ['(min-width: 1024px) and (orientation: landscape)', 4],
  ['(min-width: 768px)', 3],
  ['(min-width: 440px)', 2],
  ['', 1],
];

// The box has the --aspect-ratio of gallery.css (golden ratio). A photo wider
// than that is cropped to the box height (see cropAndPositionImage), so it is
// displayed wider than the box by this factor.
const BOX_RATIO = 1.618;
const { width, height } = item.data.image.file;
const overflow = Math.max(1, Math.round((width / height / BOX_RATIO) * 100) / 100);
const scale = overflow === 1 ? '' : ` * ${overflow}`;
// A wide photo shows only part of its width: scale the cap by the same factor
// so its visible part is as sharp as an ordinary thumbnail.
const wideWidth = Math.min(width, Math.round(MAX_VISIBLE * overflow));
const widths = wideWidth > MAX_VISIBLE ? [...THUMB_WIDTHS, wideWidth] : THUMB_WIDTHS;

const sizes = columns
  .map(([media, n]) => `${media} calc(((100vw - 2rem) / ${n} - 2rem)${scale})`.trim())
  .join(', ');
---
<div class="thumbnail" data-index={index}>
  <div class="thumbnail-image" >
    <Image src={item.data.image.file} alt="" widths={widths} sizes={sizes} />
  </div>
  <div class="thumbnail-metadata">
    <div class="thumbnail-metadata-top">
      <Tag tag={item.data.tag} />
    </div>
    <div class="thumbnail-metadata-bottom">
      <Date date={item.data.pubDate} />
      <Location geo={item.data.geo} place={item.data.place} />
    </div>
  </div>
</div>

<script>
  type ImageList = NodeListOf<HTMLImageElement> | null | undefined;

  // All the process and calculations needed to generate thumbnail which
  // take into account the widht/height ratio of images.
  document.addEventListener('DOMContentLoaded', function () {
    const images: ImageList = document.querySelectorAll('.thumbnail-image img');
    images.forEach(image => {

      if (image.complete) {
        cropAndPositionImage(image);
      } else {
        image.addEventListener('load', () => {
          cropAndPositionImage(image);
        });
      }
    });
  });

  function cropAndPositionImage(img: HTMLImageElement) {
    const imgRatio = img.width / img.height;

    // Get the ratio value declared in the :root CSS section
    const ratio = getComputedStyle(document.documentElement).getPropertyValue('--aspect-ratio');
    let ratioNum = Number(ratio);

    if (imgRatio < ratioNum) {
        img.style.width = '100%';
        img.style.height = 'auto';
    } else {
        img.style.width = 'auto';
        img.style.height = '100%';
    }
  };
</script>

<style>
  .thumbnail,
  .thumbnail-image {
    position: relative;
  }

  .thumbnail {
    cursor: pointer;
    padding: 1rem;
    transition: 0.2s;
    height: 100%; /* ensure to have the same height for all thumbnails */
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .thumbnail:hover {
    background-color: var(--active-background-color);
  }

  .thumbnail .thumbnail-image {
    aspect-ratio: var(--aspect-ratio);
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .thumbnail .thumbnail-image img {
    position: absolute;
    pointer-events: none;
    top: 50%;
    left: 50%;
    height: auto;
    transform: translate(-50%,-50%);
  }

  .thumbnail.active {
    background-color: var(--active-background-color);
  }

  .thumbnail-metadata {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .thumbnail-metadata-top {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .thumbnail-metadata-bottom {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

</style>
